# App
APP_NAME=FastAPI Layered Architecture
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=
# DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/your_db

# Auth
SECRET_KEY=change-me-to-a-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
